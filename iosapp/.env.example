# Copy this file to .env and fill in the real values.
# The app reads these at startup and refuses to boot if a required one is missing.

# --- Stripe -------------------------------------------------------------
# Secret or restricted key. Test keys start with sk_test_ or rk_test_.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret for the webhook endpoint. Starts with whsec_.
# Local development: `stripe listen` prints one when it starts.
# Production: shown once when you register the endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Price ID of the product being sold. Starts with price_.
STRIPE_PRICE_ID=price_replace_me

# --- URLs ---------------------------------------------------------------
# Public origin of this backend, no trailing slash. Stripe returns the browser
# here after checkout, so it must be reachable from the internet in production.
# Not the app's deep link: the server has to confirm the payment before the
# app takes over. See SUCCESS_DEEP_LINK below.
PUBLIC_BASE_URL=http://localhost:8000

# Deep links the browser is sent to after checkout. These use the app's
# custom scheme, which is why they cannot be given to Stripe directly.
SUCCESS_DEEP_LINK=golfcoachnow://payment-success
CANCEL_DEEP_LINK=golfcoachnow://payment-cancelled

# --- Database -----------------------------------------------------------
# SQLite is fine on a host with a persistent disk. On any platform that wipes
# the filesystem between deploys, use Postgres or payment records are lost.
#   SQLite:   sqlite:///./payments.db
#   Postgres: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./payments.db

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO

# --- Rate limiting ------------------------------------------------------
# Applies only to /payments/checkout-session and /payments/unlock-status.
# The webhook is never limited: Stripe decides when to send events, and a 429
# there just becomes a retry with the unlock delayed.
#
# Counted per client address. Keep it generous - mobile customers share carrier
# addresses, so a tight limit blocks buyers before it blocks abuse.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Subscriptions ---------------------------------------------------------
# The recurring price for the monthly plan. Unlike the other Stripe settings
# this one may be left empty: the app still starts and /payments/subscribe
# answers 503, which is what "not on sale yet" should look like. Deploying the
# subscription code before this price exists must not take the working
# one-time checkout down with it.
#
# Put the recurring price on a product that already carries an eligible tax
# code. Managed Payments rejects checkout for a product without one, and that
# failure happens live, on a customer's card, not in testing.
STRIPE_SUBSCRIPTION_PRICE_ID=

# Where Stripe returns the browser after the billing portal. Points straight at
# the app because nothing is recorded on the way back - cancellations arrive as
# webhooks. Stripe accepts the custom scheme; this was checked against the live
# API rather than assumed.
PORTAL_RETURN_DEEP_LINK=golfcoachnow://subscription-updated

# --- Share and Connect ---------------------------------------------------
# Where "connect with the founder" messages are delivered.
FOUNDER_EMAIL=zumba.king7@gmail.com

# The link a golfer sends a friend from the Share button. Empty is a legal
# state and means sharing is not open yet: /share/invite answers 503 and
# everything else keeps working. Nothing should be emailing people a link that
# does not exist.
APP_SHARE_URL=

# Sending mail to an address somebody typed is the most abusable thing this
# service does, so these are tighter than the sign in limits. Counted per
# caller and separately per recipient.
SHARE_RATE_LIMIT_REQUESTS=3
SHARE_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Analysis -----------------------------------------------------------
# Refuse to score a clip from its file metadata when real analysis is not
# available. Metadata scoring does not look at the video: it seeds a random
# number generator from the file's size and duration, so it answers every
# recording with confident, specific, invented coaching.
#
# Off by default only because it is not yet confirmed whether the pose
# libraries (mediapipe, opencv-python, numpy) are installed in production.
# Turn it on the moment they are, and the product can no longer invent a
# correction under any circumstances. Until then, clips that are clearly not
# recordings are still rejected outright.
STRICT_ANALYSIS=false

# --- Video assets -------------------------------------------------------
# Where the instructional and correction clips are served from, with no
# trailing slash. The apps never hold a video URL of their own; every one is
# resolved from here, so moving the assets is a change to this line rather than
# a release of three apps.
#
# Leaving it unset is a legal state and means "no videos published yet": the
# API answers with a null url, the apps go straight to the camera, and the
# written correction still comes back. Nothing breaks, nothing plays.
VIDEO_BASE_URL=

# --- Accounts -----------------------------------------------------------
# How sign in codes are delivered.
#
#   console  Writes the code to the log and sends nothing. Local development
#            only.
#   resend   Sends the code through Resend. Production must use this.
#
# The default is console, so a deployment that never sets this starts cleanly,
# logs nothing alarming, and silently signs nobody in. If sign in appears
# broken in production, check this variable before anything else.
EMAIL_PROVIDER=console

# Required when EMAIL_PROVIDER is resend. Validated at startup, so a missing
# key stops the app rather than stranding someone on a login screen.
RESEND_API_KEY=

# The From address on sign in emails. The default is Resend's shared onboarding
# domain: it works immediately with no DNS setup, but it is unbranded and more
# likely to be filtered. Verify a real domain in Resend before launch.
EMAIL_FROM=Golf Coach Now <onboarding@resend.dev>

# Six digits is short enough to type from a notification and long enough that
# guessing is pointless once attempts are capped.
LOGIN_CODE_LENGTH=6
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5

# Much tighter than the general limit above, because this endpoint sends email.
# Counted per caller and separately per address, so neither can one person mail
# the world nor the world mail one person.
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
